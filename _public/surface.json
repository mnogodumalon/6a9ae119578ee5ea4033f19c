{
  "version": 1,
  "pages": [
    {
      "slug": "kursanmeldung",
      "component": "Kursanmeldung",
      "title": "Kursanmeldung – Musikschule Klangraum",
      "endpoints": [
        {
          "entity": "kurse",
          "op": "list",
          "fields": [
            "titel",
            "instrument",
            "niveau",
            "wochentage",
            "beginn",
            "uhrzeit",
            "maximale_teilnehmer",
            "preis",
            "status"
          ],
          "scope": "r.v_status == 'geplant'",
          "scope_description": "Zeigt nur Kurse mit Status 'geplant'",
          "max_records": 500
        },
        {
          "entity": "anmeldungen",
          "op": "list",
          "fields": [
            "kurs",
            "status"
          ],
          "scope": "r.v_status not in ['abgemeldet']",
          "scope_description": "Zeigt aktive Anmeldungen (nicht abgemeldet) für die Kapazitätsberechnung",
          "max_records": 500
        },
        {
          "entity": "teilnehmer",
          "op": "create",
          "fields": [
            "vorname",
            "nachname",
            "geburtsdatum",
            "email",
            "telefon",
            "erziehungsberechtigte_person"
          ]
        },
        {
          "entity": "anmeldungen",
          "op": "create",
          "fields": [
            "kurs",
            "teilnehmer",
            "anmeldedatum"
          ],
          "preset_fields": {
            "status": "neu",
            "bezahlt": false
          }
        }
      ]
    },
    {
      "slug": "kursuebersicht",
      "component": "Kursuebersicht",
      "title": "Kursübersicht – Musikschule Klangraum",
      "endpoints": [
        {
          "entity": "kurse",
          "op": "list",
          "fields": [
            "titel",
            "instrument",
            "niveau",
            "wochentage",
            "beginn",
            "ende",
            "uhrzeit",
            "maximale_teilnehmer",
            "preis",
            "status"
          ],
          "scope": "r.v_status in ['geplant', 'laeuft']",
          "scope_description": "Zeigt nur laufende und geplante Kurse — abgeschlossene und abgesagte Kurse werden ausgeblendet",
          "max_records": 500
        },
        {
          "entity": "anmeldungen",
          "op": "list",
          "fields": [
            "kurs",
            "status"
          ],
          "scope": "r.v_status not in ['abgemeldet']",
          "scope_description": "Zeigt nur aktive Anmeldungen (nicht abgemeldet) zum Berechnen der freien Plätze",
          "max_records": 500
        }
      ]
    }
  ]
}